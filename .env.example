# =============================================================
# OPERATOR — environment template
# Copy to .env.local and fill in real values. Never commit .env.local.
# =============================================================

# --- Supabase (required, phase 1) -----------------------------
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by route handlers / cron jobs that need elevated
# access (admin reads, backfills). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (phase 3 — coach panel) ------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Strava OAuth (phase 2 — activity sync) -------------------
# https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Withings OAuth (phase 2 — body composition sync) ---------
# https://developer.withings.com/dashboard/
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
