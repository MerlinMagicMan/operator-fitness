# =============================================================
# OPERATOR — environment template
# Copy to .env.local and fill in real values. Never commit .env.local.
# =============================================================

# --- Supabase (required, phase 1) -----------------------------
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by route handlers / cron jobs that need elevated
# access (admin reads, backfills). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site URL (required, phase 2a — magic-link auth) ----------
# Used as the `emailRedirectTo` base when sending magic links so the
# callback lands on the right deployment.
#   - Local dev:   http://localhost:3000
#   - Production:  https://operator-fitness.vercel.app  (or your domain)
# Set this in Vercel for every environment (Production, Preview, Development).
NEXT_PUBLIC_SITE_URL=

# --- Anthropic (phase 3 — coach panel) ------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Strava OAuth (phase 2c — activity sync) -----------------
# Register the API app at https://www.strava.com/settings/api and copy
# the Client ID + Client Secret. The redirect URI must match exactly
# what's saved on the app's "Authorization Callback Domain" settings —
# Strava only accepts the domain on signup; the full path is set here.
#   - Local dev:   http://localhost:3000/api/strava/callback
#   - Production:  https://operator-fitness.vercel.app/api/strava/callback
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=

# --- Cron secret (phase 2c — Strava sync cron) ---------------
# Random secret used to authenticate /api/strava/sync invocations.
# Vercel cron jobs send this automatically as `Authorization: Bearer
# $CRON_SECRET` when configured in vercel.json. Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# --- Withings OAuth (phase 2d — body composition sync) -------
# https://developer.withings.com/dashboard/
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
